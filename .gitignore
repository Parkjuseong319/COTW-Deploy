@'
# Environment variables and secrets
.env
.env.*
!.env.production
!.env.example
**/.env
**/.env.*
!**/.env.example

# Java / Gradle
**/.gradle/
**/build/
**/out/

# Node / Vue
**/node_modules/
**/dist/

# Logs
**/logs/
*.log

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local patches and temporary files
*.patch
*.tmp
'@ | Set-Content -Encoding utf8 .\.gitignore